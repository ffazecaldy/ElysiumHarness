{
  "name": "@elysium/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI entry point for Elysium Harness.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "elysium": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elysium/core": "workspace:*",
    "@elysium/extension-tools": "workspace:*",
    "@elysium/tui": "workspace:*"
  }
}
