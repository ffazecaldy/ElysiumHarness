# Elysium Harness — Provider Configuration
# Copy to .env and fill in your API keys.
# Supported providers (all OpenAI-compatible):
#
#   openai      — https://api.openai.com/v1          (GPT-4o, GPT-4o-mini, o1, o3)
#   deepseek    — https://api.deepseek.com/v1         (DeepSeek V3, R1)
#   groq        — https://api.groq.com/openai/v1      (Llama 3, Mixtral, Gemma)
#   together    — https://api.together.xyz/v1          (Llama, Mixtral, Qwen, etc.)
#   openrouter  — https://openrouter.ai/api/v1         (100+ models, unified)
#   ollama      — http://localhost:11434/v1             (local models, no key needed)
#   custom      — any OpenAI-compatible endpoint
#
# Anthropic (Claude) and Google (Gemini) are NOT OpenAI-compatible
# and need their own adapters. Use OpenRouter to access them via the
# OpenAI-compatible interface (recommended workaround).

ELYSIUM_PROVIDER=openai
ELYSIUM_API_KEY=sk-your-key-here
ELYSIUM_MODEL=gpt-4o-mini
ELYSIUM_BASE_URL=

# Alternative: uncomment one of these instead of ELYSIUM_PROVIDER:
# ELYSIUM_PROVIDER=deepseek
# ELYSIUM_API_KEY=sk-your-deepseek-key
# ELYSIUM_MODEL=deepseek-chat
#
# ELYSIUM_PROVIDER=groq
# ELYSIUM_API_KEY=gsk_your-groq-key
# ELYSIUM_MODEL=llama-3.3-70b-versatile
#
# ELYSIUM_PROVIDER=openrouter
# ELYSIUM_API_KEY=sk-or-your-openrouter-key
# ELYSIUM_MODEL=anthropic/claude-sonnet-4
#
# ELYSIUM_PROVIDER=ollama
# ELYSIUM_MODEL=qwen2.5:14b
# (no key needed for local Ollama)
