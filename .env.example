# Elysium Harness — Provider Configuration
# Copy to .env and fill in your API keys, or use /key command in REPL.
#
# Supported providers (all OpenAI-compatible):
#   openai      — https://api.openai.com/v1          GPT-4o, GPT-4o-mini, o1, o3
#   deepseek    — https://api.deepseek.com/v1         DeepSeek V3, R1
#   groq        — https://api.groq.com/openai/v1      Llama 3, Mixtral, Gemma (free tier)
#   glm         — https://open.bigmodel.cn/api/paas/v4  ZhiPu GLM (glm-5.3-flash)
#   opencode    — http://127.0.0.1:11434/v1           OpenCode Go (Ollama cloud models)
#   ollama      — http://localhost:11434/v1             Local models
#   openrouter  — https://openrouter.ai/api/v1         100+ models (Claude, GPT, Llama, etc.)
#   together    — https://api.together.xyz/v1           Llama, Mixtral, Qwen, etc.
#
# Or configure interactively in REPL:
#   /key openai sk-your-key-here
#   /key glm your-glm-api-key
#   /model glm glm-5.3-flash

# Credential precedence: ELYSIUM_* exported in your real shell env WIN over
# the values in this file. /key writes here (.env) — no other credentials
# file is used anywhere in Elysium Harness.
ELYSIUM_PROVIDER=openai
ELYSIUM_API_KEY=sk-your-key-here
ELYSIUM_MODEL=gpt-4o-mini
ELYSIUM_BASE_URL=
